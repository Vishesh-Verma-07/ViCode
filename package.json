{
  "name": "vicode-ai",
  "version": "1.2.0",
  "description": "An interactive terminal AI coding agent that chats with an LLM directly inside your project directory.",
  "type": "module",
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "bin": {
    "vicode": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "bun run build",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "tui",
    "terminal",
    "llm",
    "coding-agent",
    "ink"
  ],
  "license": "MIT",
  "author": "Vishesh Verma",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vishesh-Verma-07/ViCode.git"
  },
  "bugs": {
    "url": "https://github.com/Vishesh-Verma-07/ViCode/issues"
  },
  "homepage": "https://github.com/Vishesh-Verma-07/ViCode#readme",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.68",
    "chalk": "^6.0.0",
    "diff": "^9.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5"
  }
}
